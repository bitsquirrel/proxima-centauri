<UserControl x:Class="Functions_for_Dynamics_Operations.CodeSearchControl"
             xmlns:Forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             Name="MyToolWindow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid Margin="0,0,10,10" MinWidth="500" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <DockPanel Height="30" LastChildFill="False" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Label x:Name="label" VerticalAlignment="Top" Content="  Search code " Width="100" Height="22" FontWeight="Bold" FontFamily="Arial Black" Background="{x:Null}" Foreground="CadetBlue" Margin="0,6,0,0"/>
            <TextBox x:Name="SearchText" TextWrapping="Wrap" Width="620" Height="22" Margin="0,7,0,0"/>
            <Button x:Name="FileSearchCmd" VerticalAlignment="Top" Margin="5,7,0,0" Content="Search" Click="CodeSearchCmd_Click" FontWeight="Bold" Width="150" Height="22"/>
        </DockPanel>
        <DockPanel Height="60" Margin="10,35,10,0" LastChildFill="False" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <Label x:Name="labelObjectTypes" VerticalAlignment="Top" Content="Object Types:" Width="90" Height="22" FontWeight="Bold" FontFamily="Arial Black" Background="{x:Null}" Foreground="CadetBlue" Margin="0,2,0,0"/>
            <ListBox x:Name="ObjectTypesListBox" Width="620" Height="50" SelectionMode="Multiple">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="120" Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="5,2,0,0" Height="50" Width="150">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <Button x:Name="SelectAllBtn" Grid.Row="0" Content="Select All" Click="SelectAllBtn_Click" FontWeight="Bold" Width="150" Height="22"/>
                <Button x:Name="DeselectAllBtn" Grid.Row="2" Content="Deselect All" Click="DeselectAllBtn_Click" FontWeight="Bold" Width="150" Height="22"/>
            </Grid>
        </DockPanel>
        <Grid Margin = "10,100,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Content="..." Margin="0,0,10,0"/>
            <WindowsFormsHost Margin="0,0,10,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Forms:DataGridView x:Name="SearchDataGrid" Location="0,0" ColumnHeadersVisible="True" SelectionMode="FullRowSelect" MultiSelect="False" GridColor="DarkSlateGray"/>
            </WindowsFormsHost>
        </Grid>
    </Grid>
</UserControl>
